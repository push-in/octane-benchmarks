# Exact versions used by the benchmark. Change them here and nowhere else.
PAM_VERSION="${PAM_VERSION:-2.2.15}"
FRANKENPHP_VERSION="${FRANKENPHP_VERSION:-1.13.5}"
PHP_IMAGE="${PHP_IMAGE:-php:8.5.12-cli-bookworm}"
SWOOLE_VERSION="${SWOOLE_VERSION:-6.2.3}"
ROADRUNNER_VERSION="${ROADRUNNER_VERSION:-2025.1.15}"
COMPOSER_VERSION="${COMPOSER_VERSION:-2.9.3}"
# PAM's Composer bridge, only for the edge page cache section (scripts/page-cache.sh).
PAM_OCTANE_VERSION="${PAM_OCTANE_VERSION:-1.3.0}"
LARAVEL_VERSION="${LARAVEL_VERSION:-13.40.0}"
# Octane with the PAM integration (push-in/octane, branch 2.x-pam), used by every server.
OCTANE_REPOSITORY="${OCTANE_REPOSITORY:-https://github.com/push-in/octane}"
OCTANE_REF="${OCTANE_REF:-ccc1980df8c6b7346fc9b2e0e9e2b3b0d924f086}"

# Load shape. Every server gets the same workers, CPU set and wrk settings.
WORKERS="${WORKERS:-8}"
SERVER_CPUS="${SERVER_CPUS:-0-7}"
LOAD_CPUS="${LOAD_CPUS:-8-11}"
WRK_THREADS="${WRK_THREADS:-4}"
WRK_CONNECTIONS="${WRK_CONNECTIONS:-64}"
WARMUP="${WARMUP:-5s}"
DURATION="${DURATION:-15s}"
ROUNDS="${ROUNDS:-5}"
ENDPOINTS="${ENDPOINTS:-hello json db view}"
SERVERS="${SERVERS:-pam frankenphp swoole roadrunner}"
